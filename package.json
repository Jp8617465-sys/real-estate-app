{
  "name": "realflow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "quality": "turbo quality",
    "test:coverage": "turbo test:coverage",
    "harden": "turbo harden",
    "build:ba": "NEXT_PUBLIC_PRODUCT_MODE=buyers_agent turbo build --filter=@realflow/web",
    "build:selling": "NEXT_PUBLIC_PRODUCT_MODE=selling_agent turbo build --filter=@realflow/web",
    "build:full": "NEXT_PUBLIC_PRODUCT_MODE=both turbo build --filter=@realflow/web",
    "clean": "turbo clean",
    "db:migrate": "cd supabase && supabase db push",
    "db:reset": "cd supabase && supabase db reset",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > packages/shared/src/database.types.ts",
    "prepare": "is-ci || husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "turbo": "^2.8.14",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2"
}
