# Supabase Configuration (Required)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server Configuration
PORT=3001
NODE_ENV=development

# Optional AI Integration (system works without this)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_RATE_LIMIT_PER_MINUTE=50

# Optional Portal/Domain Integrations
DOMAIN_CLIENT_ID=
DOMAIN_CLIENT_SECRET=
DOMAIN_WEBHOOK_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_APP_SECRET=

# Optional Gmail Integration (for portal invite email delivery)
GMAIL_ACCESS_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Portal URL (used in portal invite magic links)
PORTAL_URL=http://localhost:3002
